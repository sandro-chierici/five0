{
	"info": {
		"_postman_id": "ore-gateway-api-collection",
		"name": "ORE Gateway API",
		"description": "REST API collection for ORE Gateway - Object Recognition Engine Gateway providing session management and frame processing endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Sessions",
			"item": [
				{
					"name": "Create Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('session_id', response.session_id);",
									"    pm.collectionVariables.set('upload_endpoint', response.upload_endpoint);",
									"    pm.collectionVariables.set('websocket_url', response.websocket_url);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"client_type\": \"web\",\n  \"model_id\": \"yolov8n\",\n  \"confidence_threshold\": 0.5,\n  \"target_classes\": [\"person\", \"car\"],\n  \"enable_tracking\": true,\n  \"max_detections\": 100\n}"
						},
						"url": {
							"raw": "{{base_url}}/sessions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions"
							]
						},
						"description": "Create a new recognition session with specified configuration including model, confidence threshold, and target classes."
					},
					"response": []
				},
				{
					"name": "Get Session Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions",
								"{{session_id}}"
							]
						},
						"description": "Retrieve current session status including frames processed, activity timestamps, and model information."
					},
					"response": []
				},
				{
					"name": "Update Session",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_id\": \"yolov8s\",\n  \"confidence_threshold\": 0.6\n}"
						},
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions",
								"{{session_id}}"
							]
						},
						"description": "Update session configuration such as model ID or confidence threshold."
					},
					"response": []
				},
				{
					"name": "Close Session",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions",
								"{{session_id}}"
							]
						},
						"description": "Close and cleanup a session, releasing all associated resources."
					},
					"response": []
				}
			],
			"description": "Session management endpoints for creating, updating, monitoring, and closing recognition sessions."
		},
		{
			"name": "Frames",
			"item": [
				{
					"name": "Submit Frame",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"frame_id\": 1,\n  \"storage_url\": \"minio://ore-frames/session-id/frame-000001.jpg\",\n  \"metadata\": {\n    \"source\": \"camera-1\",\n    \"timestamp\": \"2026-01-18T10:30:00Z\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}/frames",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions",
								"{{session_id}}",
								"frames"
							]
						},
						"description": "Submit a frame for processing with JSON metadata. The frame should be pre-uploaded to storage."
					},
					"response": []
				},
				{
					"name": "Generate Upload URL",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/sessions/{{session_id}}/frames/upload-url?frame_id=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"sessions",
								"{{session_id}}",
								"frames",
								"upload-url"
							],
							"query": [
								{
									"key": "frame_id",
									"value": "1"
								}
							]
						},
						"description": "Get a presigned URL for direct frame upload to MinIO storage."
					},
					"response": []
				}
			],
			"description": "Frame submission and upload URL generation endpoints for processing video frames."
		},
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				},
				"description": "Health check endpoint. Returns 200 OK when service is healthy."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080/api/v1",
			"type": "string"
		},
		{
			"key": "session_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "upload_endpoint",
			"value": "",
			"type": "string"
		},
		{
			"key": "websocket_url",
			"value": "",
			"type": "string"
		}
	]
}
